# Copy this file to .env and edit the values.

PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taptowash
# Hosted database (Render, Neon, Supabase, Railway…)? Either keep "?sslmode=require" at the end of
# DATABASE_URL or set PGSSL=true. Both work, including with self-signed certificates.
PGSSL=false
# Aiven (or any provider that gives you a CA certificate): download "ca.pem" from the service page,
# save it as certs/ca.pem in this project, and uncomment the next line. The connection is then fully verified.
# PGSSL_CA=certs/ca.pem
# Set to true only if you want strict verification using Node's built-in certificates
PGSSL_STRICT=false

# Aiven example (the default database is called "defaultdb" - create "taptowash" in the Aiven console to use that name):
# DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR-SERVICE.aivencloud.com:12345/defaultdb?sslmode=require

# Long random text used to sign login sessions
SESSION_SECRET=change-this-to-a-long-random-string

# First admin account, created by "npm run db:init" (only when no admin exists yet)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@taptowash.local
ADMIN_PASSWORD=ChangeMe123!
